# Lynxx — local development env template.
#
# Copy this to .env and edit. The .env file is gitignored.
# Loaded automatically by docker compose; for shell scripts source it manually:
#   set -a && source .env && set +a

# ───────────────────────────────────────────────────────────────
# Gateway runtime
# ───────────────────────────────────────────────────────────────

# Port the gateway listens on for proxy (data-plane) traffic.
# Overrides [gateway].proxy_port in the config file.
LYNXX_PROXY_PORT=28080

# Port the gateway listens on for the admin API / metrics / dashboard.
# Overrides [gateway].admin_port in the config file.
LYNXX_ADMIN_PORT=28081

# Path to the TOML config file the binary loads at startup.
# Default: ./config.toml in the working directory.
LYNXX_CONFIG=./config.toml

# Fail immediately if a port is in use instead of falling back to an
# OS-assigned random port. Set to 1 in CI / production.
# LYNXX_STRICT_PORT=1

# Health-check tick interval in ms (overrides [gateway].health_check_interval_ms).
# LYNXX_HEALTH_INTERVAL_MS=10000

# Rust log filter. `lynxx_gateway=info,tower_http=debug` is the default
# when this is unset.
RUST_LOG=info

# ───────────────────────────────────────────────────────────────
# Database
# ───────────────────────────────────────────────────────────────

# Control-plane database URL. SQLite for single-node, Postgres for HA.
# Examples:
#   sqlite://lynxx.db?mode=rwc
#   postgres://lynxx:lynxx@localhost:5432/lynxx
DATABASE_URL=sqlite://lynxx.db?mode=rwc

# Postgres password used by docker-compose.production.yml.
# Required when running that stack.
# POSTGRES_PASSWORD=change-me

# ───────────────────────────────────────────────────────────────
# Licence / auth
# ───────────────────────────────────────────────────────────────

# Master admin token bootstrap. Optional. When set, presenting this
# value as `Authorization: Bearer <value>` on the admin API counts as
# an Admin-role login — useful for ops shortcuts without creating a
# local `admin_tokens` row. Empty means only locally-issued admin
# tokens (and any keyx-issued tokens — see below) work.
LYNXX_API_KEY=

# ── Licence verification via keyx (api.keyx.vexarr.com) ──
# When all three are set AND `[license].payload` / `signature` are
# present in config.toml, the licence bundle is verified against keyx
# at boot and every 6 h. Without these, lynxx runs in "unverified"
# mode (Enterprise tier, no kill-switch) — appropriate for self-host
# and dev. Tenant is resolved by keyx from the licence URN — no
# separate tenant id needed here.
# KEYX_BASE_URL=https://api.keyx.vexarr.com
# KEYX_SERVICE_TOKEN=replace-me
# KEYX_LICENSE_URN=00000000-0000-0000-0000-000000000000

# Seconds to cache keyx-validated admin tokens. 0 (default) hits keyx
# on every admin call — instant revocation. >0 absorbs polling bursts
# at the cost of TTL-bounded staleness on revocation.
# KEYX_ADMIN_CACHE_TTL_SECS=60

# ───────────────────────────────────────────────────────────────
# Telemetry (optional — omit to disable the OTel layer entirely)
# ───────────────────────────────────────────────────────────────

# OTel collector endpoint (OTLP/HTTP). Either form works;
# LYNXX_TELEMETRY_URL wins if both are set.
# LYNXX_TELEMETRY_URL=http://otel-collector:4318
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Auth header value forwarded with OTel exports.
# LYNXX_TELEMETRY_API_KEY=

# Standard OTel resource metadata.
OTEL_SERVICE_NAME=lynxx-gateway
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development

# ───────────────────────────────────────────────────────────────
# Ingress controller (lynxx-ingress, runs in-cluster)
# ───────────────────────────────────────────────────────────────

# How the controller reaches the gateway admin API. In k8s, this is
# the Service DNS name; locally it's just the admin port.
# LYNXX_ADMIN_URL=http://localhost:28081

# Namespace to watch. Empty / unset = all namespaces.
# KUBE_NAMESPACE=lynxx-system

# ───────────────────────────────────────────────────────────────
# Bench / chaos suite
# ───────────────────────────────────────────────────────────────

# Token sent as `Authorization: Bearer ...` by lynxx-chaos against the
# admin API. Usually the same as LYNXX_API_KEY.
# LYNXX_ADMIN_TOKEN=

# ───────────────────────────────────────────────────────────────
# Docker compose
# ───────────────────────────────────────────────────────────────

# Image tag used by deploy/docker-compose.{quickstart,production}.yml.
# LYNXX_TAG=latest

# Per-container resource limits (production compose).
# GATEWAY_CPU_LIMIT=2
# GATEWAY_MEM_LIMIT=512M

# Grafana admin credentials (production compose).
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=change-me

# ───────────────────────────────────────────────────────────────
# GCE deploy script (scripts/deploy.sh)
# ───────────────────────────────────────────────────────────────

# GCS prefix holding pre-built gateway binaries (linux/amd64). The stable
# artifact lives at ${LYNXX_GCS_BUCKET}/lynxx-gateway; versioned copies
# (lynxx-gateway-v0.1.0-<git-sha>) sit next to it for rollback. The same
# prefix is what /v1/install/binary streams from when end users curl
# install_gateway.sh.
# LYNXX_GCS_BUCKET=gs://lynxx-public/gateway/linux/amd64

# Target VM and zone for the SSH-based deploy / rollback flow.
# LYNXX_VM_NAME=lynxx-gateway-prod
# LYNXX_VM_ZONE=us-central1-a
