# Copy to .env and edit. orchestrate.sh sources this.
# .env is gitignored — never commit your local values.

# ─── Azure ──────────────────────────────────────────────────────────────
AZ_LOCATION=eastus2
AZ_RG=bench-rg
AZ_VNET=proxybench-vnet
AZ_SUBNET=proxybench-subnet
AZ_NSG=proxybench-nsg
AZ_PPG=                            # proximity placement group; empty = none (PPG locks zone)

# ─── VMs ────────────────────────────────────────────────────────────────
SUT_NAME=proxybench-sut
SUT_SIZE=Standard_E32bds_v5        # 32 vCPU, 256 GB RAM, 1.2 TB local NVMe
CLIENT_NAME=proxybench-client
CLIENT_SIZE=Standard_F32s_v2       # 32 vCPU compute-optimized

# ─── Image + login ──────────────────────────────────────────────────────
AZ_IMAGE=Ubuntu2404
ADMIN_USER=azureuser
SSH_PUBKEY=~/.ssh/id_ed25519.pub   # change to wherever your pubkey lives;
                                   # private key is inferred (path minus .pub)

# ─── Local ──────────────────────────────────────────────────────────────
LOCAL_REPO=../..                   # path to gateway repo root (parent of bench/)
RESULTS_DIR=./results

# ─── Bench parameters ───────────────────────────────────────────────────
RPS_LEVELS="10000 25000 50000 100000 200000 400000 600000 800000 1000000"
DURATION_SECS=60
WARMUP_SECS=5
CONNECTIONS=512
P99_EXPLODE_MS=100                 # mark a level "exploded" if p99 > this
ERR_EXPLODE_RATE=0.01              # ...or if error rate > 1%

# ─── Proxies (run order). direct = no-proxy baseline. ──────────────────
PROXIES="direct lynxx nginx haproxy envoy traefik kong"
