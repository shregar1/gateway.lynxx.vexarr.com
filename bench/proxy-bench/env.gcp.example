# Copy to .env and edit. orchestrate.sh sources this.
# .env is gitignored — never commit your local values.
#
# This is the GCP variant of env.example. Set CLOUD=gcp to make
# orchestrate.sh dispatch to the gcloud-flavored provision/teardown
# scripts. The bench-shape vars at the bottom are identical to the
# Azure file — same RPS ladder, same proxies, same explode thresholds.

# Selects which 00-provision-*.sh / 99-teardown-*.sh pair runs.
CLOUD=gcp

# ─── GCP ────────────────────────────────────────────────────────────────
GCP_PROJECT=vexarr-com-495315
GCP_ZONE=us-central1-a
GCP_NETWORK=proxybench-vpc
GCP_SUBNET=proxybench-subnet

# ─── VMs ────────────────────────────────────────────────────────────────
# n2-highcpu-32: 32 vCPU, 32 GB RAM, ~$1.16/hr each = ~$2.32/hr total.
# Roughly matches Azure F32s_v2 (32 vCPU compute-optimized). Both VMs in
# the same zone (same network fabric → low-latency LAN hop).
SUT_NAME=proxybench-sut
SUT_MACHINE=n2-highcpu-32
CLIENT_NAME=proxybench-client
CLIENT_MACHINE=n2-highcpu-32

# ─── Image + login ──────────────────────────────────────────────────────
# Ubuntu 24.04 LTS to match the Azure rig (setup-sut.sh / setup-client.sh
# assume apt + sysctl + cpufrequtils).
GCP_IMAGE_FAMILY=ubuntu-2404-lts-amd64
GCP_IMAGE_PROJECT=ubuntu-os-cloud

# Username gcloud installs on the VM. Anything goes — matches the user
# part of $ADMIN_USER in the metadata ssh-keys entry.
ADMIN_USER=benchuser

# SSH pubkey to install on the VM. gcloud generates one at
# ~/.ssh/google_compute_engine on first use; reuse it here so manual
# `ssh benchuser@<ip>` (used by orchestrate.sh + deploy-lynxx.sh) works
# without `gcloud compute ssh` indirection.
SSH_PUBKEY=~/.ssh/google_compute_engine.pub

# ─── Bench shape (cloud-agnostic; read by run-bench.sh) ─────────────────
# Peak-RPS sweep ladder. Each level held for DURATION_SECS. The level is
# marked "exploded" when error rate > ERR_EXPLODE_RATE OR p99 > P99_EXPLODE_MS.
# Peak = highest non-exploded level.
RPS_LEVELS="10000 25000 50000 100000 200000 400000 600000 800000 1000000"
DURATION_SECS=60
WARMUP_SECS=10
CONNECTIONS=1024
P99_EXPLODE_MS=100
ERR_EXPLODE_RATE=0.01

# 'direct' is a no-proxy baseline (client hits the upstream on the SUT
# directly). Subtracted from every proxy number to isolate proxy overhead.
PROXIES="direct lynxx nginx haproxy envoy traefik kong"

# Source repo to rsync to both VMs (deploy-lynxx.sh).
LOCAL_REPO=/Users/shreyansh/Documents/vexarr/lynxx/external/core/gateway.lynxx.vexarr.com
