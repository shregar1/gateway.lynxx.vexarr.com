# Copy to .env (gitignored) before `docker compose up`.
#
#   cp .env.example .env
#   $EDITOR .env
#
# Anything marked REQUIRED has no safe default — compose will fail-fast
# with a clear message if you leave it unset.

# ─── REQUIRED ────────────────────────────────────────────────────────────────
# Image tag. Pin to a release tag in production:
#   ghcr.io/lynxx/lynxx-gateway:v0.1.x
LYNXX_TAG=latest

# Master admin/API key. Generate ONCE then never share. With this token
# someone can reconfigure your gateway. Treat it like a root password.
#   openssl rand -hex 32
LYNXX_API_KEY=change-me-openssl-rand-hex-32

# Postgres password for the control plane. Used only inside the compose
# network; not exposed externally. Still: generate, don't reuse.
#   openssl rand -base64 32
POSTGRES_PASSWORD=change-me-please-use-openssl-rand

# Grafana admin password. UI is bound to 127.0.0.1 only, so this gates
# `ssh -L 3000:localhost:3000`. Still: generate, don't reuse.
#   openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=change-me-please-use-openssl-rand
GRAFANA_ADMIN_USER=admin

# ─── LICENSE (REQUIRED past 14-day trial) ────────────────────────────────────
# Issued by the Vexarr billing service at signup; arrives in your activation
# email. Without these, the gateway runs in `unverified` mode and rejects
# enterprise-tier features.
KEYX_BASE_URL=https://api.keyx.vexarr.com
KEYX_LICENSE_URN=
KEYX_SERVICE_TOKEN=
# How long to cache keyx admin-token validations (0 = hit keyx every request).
KEYX_ADMIN_CACHE_TTL_SECS=60

# ─── Gateway runtime knobs ───────────────────────────────────────────────────
RUST_LOG=info
GATEWAY_CPU_LIMIT=2
GATEWAY_MEM_LIMIT=512M

# Refuse to start if the configured port is busy, rather than silently
# falling back to an OS-assigned random one. Always set this in prod.
LYNXX_STRICT_PORT=true

# ─── Backups (optional, recommended) ─────────────────────────────────────────
# Backups service runs pg_dump every BACKUP_INTERVAL_HOURS and keeps the last
# BACKUP_RETENTION_DAYS worth locally under the lynxx-backups volume. If
# BACKUP_S3_URL is set, also pushes there (rclone/restic). See deploy/backups/.
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
# BACKUP_S3_URL=s3://your-bucket/lynxx-backups/
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ─── Telemetry (optional) ────────────────────────────────────────────────────
# Point traces at any OTLP/HTTP collector. Leave unset to disable OTel export.
# LYNXX_TELEMETRY_URL=http://otel-collector:4318
