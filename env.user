# Lynxx — RUNTIME env vars (documentation).
#
# This file is reference-only. It is NOT loaded by the gateway at
# startup; copy the bits you need into your own `.env`, shell profile,
# systemd unit, Helm chart, Dockerfile, etc.
#
# Build-time vars (AUTH_URL) live in `.env` — those are baked into the
# binary. The vars in this file are read by the running process every
# time it starts.
# ─────────────────────────────────────────────────────────────────────


# ─── Required to boot ────────────────────────────────────────────────

# Customer's vexarr api key. Validated against the auth backend on boot
# (the URL baked in at build time). Without this the gateway refuses
# to start.
#
# Tip: the same key serves as the master admin bearer for the dashboard
# and the admin HTTP API.
LYNXX_API_KEY=lnx_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ─── Ports & paths ───────────────────────────────────────────────────

# Port the gateway listens on for proxy (data-plane) traffic.
# Overrides [gateway].proxy_port in config.toml.
LYNXX_PROXY_PORT=28080

# Port the gateway listens on for the admin API + dashboard.
# Overrides [gateway].admin_port in config.toml.
LYNXX_ADMIN_PORT=28081

# Control-plane database URL. SQLite for single-node, Postgres for HA.
#   sqlite://lynxx.db?mode=rwc
#   postgres://lynxx:secret@localhost:5432/lynxx
DATABASE_URL=sqlite://lynxx.db?mode=rwc

# Where the licence-verify cache lives. Falls back to ~/.lynxx/.
# Useful in containers when $HOME is unset.
# LYNXX_CACHE_DIR=/var/lib/lynxx


# ─── Logging ─────────────────────────────────────────────────────────

# Tracing filter. Default when unset: `lynxx_gateway=info,tower_http=debug`.
# RUST_LOG=lynxx_gateway=debug

# Pretty-print panics with full backtraces.
# RUST_BACKTRACE=1


# ─── Telemetry (OTLP) ────────────────────────────────────────────────
# Unset = no OTel export. Setting any of these turns the OTel layer on.

# OTLP HTTP endpoint (overrides [telemetry].endpoint).
# Aliases: OTEL_EXPORTER_OTLP_ENDPOINT
# LYNXX_TELEMETRY_URL=http://localhost:4318

# Bearer token sent on OTLP exports (overrides [telemetry].api_key).
# LYNXX_TELEMETRY_API_KEY=xxxxx

# Service name embedded in every span. Default: lynxx-gateway.
# OTEL_SERVICE_NAME=lynxx-gateway

# Reduce telemetry surface (skip per-route detail spans, cardinality cap).
# Legacy alias: LYNXX_BENCH_MODE.
# LYNXX_MINIMAL_TELEMETRY=1


# ─── Plugin-side / feature-specific ──────────────────────────────────

# TLS handshake logging for Wireshark debugging. Don't set in production.
# SSLKEYLOGFILE=/tmp/lynxx-tls.keys

# Cluster discovery on Kubernetes (kubelet usually sets these for you).
# HOSTNAME=
# KUBE_NAMESPACE=

# ACME DNS-01 challenge — only set the provider you actually use.
# AWS:        AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION
# Azure:      AZURE_DNS_TOKEN, AZURE_DNS_ZONE, AZURE_RESOURCE_GROUP, AZURE_SUBSCRIPTION_ID
# DigitalOcean: DIGITALOCEAN_TOKEN
# DuckDNS:    DUCKDNS_TOKEN
# Gandi:      GANDI_TOKEN
# GCloud:     GCLOUD_DNS_TOKEN, GCLOUD_DNS_ZONE, GCLOUD_PROJECT
# Hetzner:    HETZNER_DNS_TOKEN, HETZNER_DNS_ZONE_ID
# Linode:     LINODE_TOKEN, LINODE_DOMAIN_ID
# Namecheap:  NAMECHEAP_API_USER, NAMECHEAP_API_KEY, NAMECHEAP_CLIENT_IP
# OVH:        OVH_APPLICATION_KEY, OVH_CONSUMER_KEY, OVH_DNS_ZONE
# Porkbun:    PORKBUN_API_KEY, PORKBUN_SECRET_KEY
# Vultr:      VULTR_API_KEY
